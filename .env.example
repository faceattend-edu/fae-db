# FaceAttend EDU — fae-db: plantilla de variables de entorno.
# Copiar a `.env` junto al docker-compose.yml de este repositorio:
#   copy .env.example .env   (Windows)    |    cp .env.example .env   (Linux/macOS)
# Cada repositorio lee SOLO su propio .env. Nada de esto es un secreto real; en producción
# inyéctalos por entorno o gestor de secretos.
# Los 8 *_DB_PASSWORD MONGO_USER/PASSWORD/DB y MINIO_ROOT_USER/PASSWORD deben ser IGUALES en fae-api/.env: aquí se crean, allí se usan.


# Las contraseñas no tienen default en compose: `docker compose up` falla hasta definirlas.
# Genera cada secreto con:  openssl rand -base64 32

# ── PostgreSQL 17 (1 instance, 8 schemas) ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=faceattend_db
POSTGRES_PORT=5432
FACEATTEND_LIQUIBASE_IMAGE=liquibase/liquibase:4.29.0
# Liquibase contexts: `seed` = catalogs (roles, permissions, policies…).
# Production runs only `seed`; `demo` changesets never run there.
LIQUIBASE_CONTEXTS=seed

# ── One database login per service (data isolation, 03-dcl roles) ──
# Required. Each service logs in as <service>_app and can only touch its own
# schema. Use URL-safe values (they go inside connection URLs): openssl rand -hex 24
IDENTITY_DB_PASSWORD=
AUTHORIZATION_DB_PASSWORD=
ACADEMIC_DB_PASSWORD=
SCHEDULING_DB_PASSWORD=
ATTENDANCE_DB_PASSWORD=
CONFIGURATION_DB_PASSWORD=
QUALITY_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=

# ── MongoDB 7 (biometric vectors) ──
# Authentication is mandatory (mongod --auth). Changing these after the volume
# exists does not change the real password: use database/scripts/rotate-mongo-password.sh
MONGO_USER=
MONGO_PASSWORD=
MONGO_DB=faceattend_biometric
MONGO_PORT=27017

# ── MinIO (justification supporting documents, ADR-009) ──
# Required, no defaults. MINIO_KMS_SECRET_KEY = <name>:<base64 of 32 bytes>, e.g.
#   echo "faceattend-key:$(openssl rand -base64 32)"
# It encrypts every stored file (SSE-S3). Back it up: without it the files cannot be read.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_KMS_SECRET_KEY=

# ── Redis 7 (Kong rate-limiting) ──
REDIS_PORT=6379

# ── Neon (PostgreSQL externo, producción) — solo docker-compose.neon.yml ──
# NEON_JDBC_URL=jdbc:postgresql://<host>/<db>?sslmode=require
# NEON_USER=
# NEON_PASSWORD=
